generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COLLECTOR
  CASHIER
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String   @default("Admin User")
  role      Role     @default(COLLECTOR)
  createdAt DateTime @default(now())
  upiId     String?
  donations Donor[]
  loginLogs LoginLog[]
  expenses  Expense[]
  transfersReceived CashTransfer[] @relation("CashierTransfers")
  transfersSent     CashTransfer[] @relation("CollectorTransfers")
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model Expense {
  id              Int           @id @default(autoincrement())
  userId          Int
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount          Float
  description     String
  billPhotoBase64 String        @db.Text
  latitude        Float?
  longitude       Float?
  paymentNumber   String?       // Collector's GPay/PhonePe number
  cashierId       Int?          // Which cashier paid this
  paymentMode     String?       // Cash, UPI
  status          ExpenseStatus @default(PENDING)
  deductedFromAdvance Boolean @default(false)
  claimFromAdvance    Boolean @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model LoginLog {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id])
  photoBase64     String    @db.Text
  loginLatitude   Float?
  loginLongitude  Float?
  logoutTime      DateTime?
  logoutLatitude  Float?
  logoutLongitude Float?
  createdAt       DateTime  @default(now())
}

model Donor {
  id            Int      @id @default(autoincrement())
  receiptNumber String   @unique
  donorName     String
  mobile        String
  street        String
  doorNumber    String?
  amount        Float
  paymentMode   String   // Cash, UPI, Bank Transfer
  purpose       String   @default("Vinayagar Chadurthi 2026")
  remarks       String?
  collector     String
  userId        Int?
  user          User?    @relation(fields: [userId], references: [id])
  date          DateTime @default(now())
  pdfUrl        String?
  upiScreenshot String?  @db.Text
  latitude      Float?
  longitude     Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Settings {
  id              Int      @id @default(autoincrement())
  associationName String   @default("Dr. A.P.J. Abdul Kalam Association")
  presidentName   String
  secretaryName   String   @default("Jane Doe")
  defaultPurpose  String   @default("Vinayagar Chadurthi 2026")
  financialYear   String   @default("2026-2027")
  githubRepo      String
  whatsappMessage String
  whatsappMessageTa String @default("")
  upiId           String   @default("default@upi")
  streetLinks     Json?    @default("{}")
  updatedAt       DateTime @updatedAt
}

enum TransferType {
  MONEY_IN
  MONEY_OUT
}

model CashTransfer {
  id          Int          @id @default(autoincrement())
  cashierId   Int
  cashier     User         @relation("CashierTransfers", fields: [cashierId], references: [id])
  collectorId Int
  collector   User         @relation("CollectorTransfers", fields: [collectorId], references: [id])
  type        TransferType @default(MONEY_IN)
  amount      Float
  paymentMode String       // Cash, UPI
  description String?      @db.Text
  createdAt   DateTime     @default(now())
}
