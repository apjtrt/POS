generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COLLECTOR
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String   @default("Admin User")
  role      Role     @default(COLLECTOR)
  createdAt DateTime @default(now())
  donations Donor[]
  loginLogs LoginLog[]
}

model LoginLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  photoBase64 String   @db.Text
  createdAt   DateTime @default(now())
}

model Donor {
  id            Int      @id @default(autoincrement())
  receiptNumber String   @unique
  donorName     String
  fatherName    String?
  mobile        String
  street        String
  doorNumber    String?
  amount        Float
  paymentMode   String   // Cash, UPI, Bank Transfer
  purpose       String   @default("Vinayagar Chadurthi 2026")
  remarks       String?
  collector     String
  userId        Int?
  user          User?    @relation(fields: [userId], references: [id])
  date          DateTime @default(now())
  pdfUrl        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Settings {
  id              Int      @id @default(autoincrement())
  associationName String   @default("Dr. A.P.J. Abdul Kalam Association")
  presidentName   String
  treasurerName   String
  defaultPurpose  String   @default("Vinayagar Chadurthi 2026")
  financialYear   String   @default("2026-2027")
  githubRepo      String
  whatsappMessage String
  upiId           String   @default("default@upi")
  updatedAt       DateTime @updatedAt
}
